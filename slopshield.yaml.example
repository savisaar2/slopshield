# SlopShield Configuration
# Set your API keys here to use the multi-engine prober.

registry_url: "https://raw.githubusercontent.com/YOUR_USERNAME/slopshield/main/registry"

# Detection settings
reputation_age_days: 14
enable_typosquatting: true

# Protect specific internal packages from typosquatting
typosquatting_targets:
  npm:
    - "my-internal-auth"
    - "core-utils-pro"

# Polite rate limiting (requests per second)
rate_limits:
  npm: 5.0
  python: 3.0
  go: 10.0

# Custom registry URLs for private packages
private_registries:
  npm: "https://registry.npmjs.org"
  python: "https://pypi.org/pypi"
  go: "https://proxy.golang.org"

providers:
  openai_api_key: ""
  anthropic_api_key: ""
  gemini_api_key: ""
  
  ollama:
    enabled: true
    url: "http://localhost:11434/api/generate"
    model: "llama3"
